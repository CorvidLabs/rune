{
  "version": 1,
  "enabled": true,
  "require_change_for_meaningful_files": true,
  "meaningful_paths": [
    "src/",
    "tests/",
    "site/",
    "bin/",
    "spec/",
    ".github/",
    "Cargo.toml",
    "Cargo.lock",
    "action.yml",
    "package.json",
    "bun.lock",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "Package.swift",
    "Package.resolved",
    "go.mod",
    "go.sum",
    "pyproject.toml",
    "uv.lock",
    "requirements.txt",
    "Gemfile",
    "Gemfile.lock",
    "plugin.toml",
    "rune.gemspec",
    ".specsync/sdd.json",
    ".specsync/config.toml",
    ".specsync/config.json",
    ".specsync/registry.toml",
    ".specsync/version",
    "lib/",
    "scripts/",
    "fledge.toml"
  ],
  "ignored_paths": [
    ".specsync/",
    "specs/"
  ],
  "verification_commands": [
    "fledge run version-check",
    "fledge run lint",
    "fledge run test",
    "fledge run smoke-test"
  ],
  "custom_artifacts": {},
  "principles_file": null
}
